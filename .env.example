# Copy this file to .env and fill in the keys you have.
# .env is gitignored; .env.example is tracked.
#
# wikitrace runs locally — these keys are only used to call external
# services on your behalf. Nothing is uploaded anywhere else.

# ─── REQUIRED for the chat / agent ──────────────────────────────────────
# OpenRouter — single API key for OpenAI, Anthropic, Google, Llama, etc.
# Free tier works for the demo (gpt-oss-120b is the default fallback).
# Sign up: https://openrouter.ai/
OPENROUTER_API_KEY=

# ─── REQUIRED for PDF uploads ───────────────────────────────────────────
# Pulse — turns a PDF into clean Markdown via /extract.
# Free credits on signup, ~1 credit per PDF page.
# Without this, the chat works but Upload PDF will return "Pulse key not set".
# Sign up: https://docs.runpulse.com/
PULSE_API_KEY=

# ─── OPTIONAL ───────────────────────────────────────────────────────────
# Pin a specific model instead of the fallback chain.
# Example: anthropic/claude-sonnet-4.5, openai/gpt-4o-mini, openai/gpt-oss-120b:free
# WIKITRACE_MODEL=
