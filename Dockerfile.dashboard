# wikitrace observability dashboard — Next.js, cloud-mode by default
#
# Build:  docker build -f Dockerfile.dashboard -t wikitrace-dashboard .
# Run:    docker run -p 3000:3000 \
#           -e WIKITRACE_BACKEND=cloud \
#           -e WIKITRACE_CLOUD_URL=http://wikitrace-cloud:8001 \
#           wikitrace-dashboard

FROM node:20-slim AS deps
WORKDIR /app
COPY app/package.json app/package-lock.json* /app/
RUN npm ci --omit=dev || npm install --omit=dev

FROM node:20-slim AS builder
WORKDIR /app
COPY app /app
RUN npm install
RUN npm run build

FROM node:20-slim AS runner
WORKDIR /app
ENV NODE_ENV=production \
    PORT=3000

COPY --from=deps /app/node_modules /app/node_modules
COPY --from=builder /app/.next /app/.next
COPY --from=builder /app/public /app/public 2>/dev/null || true
COPY --from=builder /app/package.json /app/package.json
COPY --from=builder /app/next.config.ts /app/next.config.ts

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "require('http').get('http://127.0.0.1:3000/sign-in', r => process.exit(r.statusCode === 200 ? 0 : 1))" || exit 1

CMD ["npm", "start", "--", "-p", "3000"]
