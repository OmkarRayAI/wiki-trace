# wikitrace cloud server — multi-tenant ingestion + read API
#
# Build:  docker build -f Dockerfile.cloud -t wikitrace-cloud .
# Run:    docker run -p 8001:8001 \
#           -e WIKITRACE_CLOUD_ADMIN_KEY=... \
#           -v wikitrace_data:/data \
#           wikitrace-cloud

FROM python:3.12-slim

WORKDIR /app

# System deps. Keep this list short — sqlite + curl for healthcheck.
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl \
 && rm -rf /var/lib/apt/lists/*

# Python deps. Pinning the cloud extras keeps the image reproducible.
COPY pyproject.toml /app/pyproject.toml
COPY wikitrace /app/wikitrace
RUN pip install --no-cache-dir ".[cloud]"

# Persistent state (sqlite db) goes here.
RUN mkdir -p /data

ENV WIKITRACE_CLOUD_DB=/data/wikitrace-cloud.db \
    WIKITRACE_CLOUD_HOST=0.0.0.0 \
    WIKITRACE_CLOUD_PORT=8001

EXPOSE 8001

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD curl -f http://127.0.0.1:8001/v1/health || exit 1

# Admin key MUST be supplied at runtime — the server runs without auth
# on the admin endpoints if it's missing, which is fine for dev but
# never the default we want in a container.
CMD ["sh", "-c", "python -m wikitrace.cloud.serve --host $WIKITRACE_CLOUD_HOST --port $WIKITRACE_CLOUD_PORT --db $WIKITRACE_CLOUD_DB"]
